{
  "name": "onlyread",
  "version": "1.0.1",
  "description": "Read-only mode for browser AI agents: a Chrome extension that refuses writes on the sites you guard, and the harness that measures it",
  "keywords": [
    "ai-agent",
    "browser-agent",
    "agent-safety",
    "read-only",
    "chrome-extension",
    "manifest-v3",
    "llm",
    "guardrails",
    "security"
  ],
  "homepage": "https://onlyread.ai",
  "bugs": {
    "url": "https://github.com/onlyreadai/onlyread/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onlyreadai/onlyread.git"
  },
  "license": "AGPL-3.0-only",
  "author": "OnlyRead AI (In Formation)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:py": "python3 harness/lib/test_fingerprint.py",
    "lint": "biome lint && python3 -m ruff check .",
    "check": "npm run typecheck && npm run lint && npm run coverage && npm run test:py && npm run build && npm run scrub",
    "fixture": "node fixtures/testapp/server.ts",
    "e2e": "npm run build && playwright test",
    "scrub": "python3 harness/scrub_check.py",
    "bundle": "python3 harness/bundle.py",
    "release": "npm run check && python3 harness/bundle.py --strict",
    "hooks": "git config core.hooksPath scripts/hooks",
    "e2e:live": "npm run build && ONLYREAD_LIVE=1 playwright test e2e/live-judge.spec.ts --retries=2",
    "e2e:replay": "npm run build && playwright test e2e/replay.spec.ts",
    "e2e:replay:watch": "npm run build && HEADED=1 playwright test e2e/replay.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  }
}
